import pygame
import math

width = 1200
height = 600
screen = pygame.display.set_mode((width, height))
clock = pygame.time.Clock()
x_pos = width / 2
y_pos = height / 2

running = True
while running:
    clock.tick(60)
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_r:
                x_pos = width / 2
                y_pos = height / 2

    keys = pygame.key.get_pressed()
    if keys[pygame.K_UP]:
        y_pos -= 1
    if keys[pygame.K_DOWN]:
        y_pos += 1
    if keys[pygame.K_RIGHT]:
        x_pos += 1
    if keys[pygame.K_LEFT]:
        x_pos -= 1


    screen.fill((0, 0, 0))
    pygame.draw.rect(screen, (0, 0, 255), (x_pos, y_pos, 5, 5))
    pygame.display.flip()
pygame.quit